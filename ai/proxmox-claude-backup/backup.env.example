# Proxmox backup integration: client configuration example.
# Copy to ~/.config/proxmox/backup.env, replace the placeholders, then:
#   chmod 700 ~/.config/proxmox
#   chmod 600 ~/.config/proxmox/backup.env
# proxmox-backup.sh sources this file as shell code. Keep it owned by,
# and writable only by, the user that runs Claude Code.
# Never commit the filled-in file.

# Proxmox VE API address. HTTPS is required.
PVE_HOST="https://<pve-address>:8006"

# Node that runs the VMs to back up.
PVE_NODE="<pve-node>"

# Proxmox storage ID for the backups. Must allow the VZDump backup content type.
PVE_STORAGE="local"

# API token ID, in the format user@realm!tokenid.
PVE_TOKEN_ID="<api-user>@pve!<token-name>"

# API token secret. Proxmox shows it only once, when the token is created.
PVE_TOKEN_SECRET="<token-secret>"

# TLS certificate verification. Keep this at "true" when the node has a
# certificate this VM trusts.
# A node that still uses the default self-signed Proxmox certificate fails
# verification. In that case, set this to "false", or every request fails.
# Risk: with "false", curl runs with --insecure and doesn't check the server's
# identity. Anyone who can intercept traffic between this VM and the node could
# impersonate the API and capture the token secret.
PVE_VERIFY_TLS="true"
