# Proxmox backup integration: client configuration example.
# Copy to ~/.config/proxmox/backup.env, replace the placeholders, then:
#   chmod 700 ~/.config/proxmox
#   chmod 600 ~/.config/proxmox/backup.env
# proxmox-backup.sh sources this file as shell code. It refuses to run unless
# the file is owned by the current user with mode 600 or stricter, and the
# directory isn't writable by group or others.
# Never commit the filled-in file.

# Proxmox VE API address. HTTPS is required.
PVE_HOST="https://<pve-address>:8006"

# Node that runs the VMs to back up.
PVE_NODE="<pve-node>"

# Proxmox storage ID for the backups. Must allow the VZDump backup content type.
PVE_STORAGE="local"

# API token ID, in the format user@realm!tokenid.
PVE_TOKEN_ID="<api-user>@pve!<token-name>"

# API token secret. Proxmox shows it only once, when the token is created.
PVE_TOKEN_SECRET="<token-secret>"

# TLS certificate verification. Keep this at "true".
# A node that still uses the default self-signed Proxmox certificate fails
# verification unless this VM trusts the node's CA. To verify it, copy the
# node's /etc/pve/pve-root-ca.pem to this VM and set PVE_CA_FILE below. The
# certificate must also be valid for the name or address in PVE_HOST.
# Setting this to "false" makes curl run with --insecure: it doesn't check the
# server's identity, so anyone who can intercept traffic between this VM and
# the node could impersonate the API and capture the token secret. Every run
# then prints a warning and reports TLS verification as DISABLED.
PVE_VERIFY_TLS="true"

# Optional CA certificate used to verify the node (leave empty to use the
# system CA store). Must not be set when PVE_VERIFY_TLS is "false".
#PVE_CA_FILE="$HOME/.config/proxmox/pve-root-ca.pem"

# Optional: warn when free space on the backup storage is below this
# percentage of its size (0-99, default 20).
#PVE_LOW_SPACE_PERCENT="20"
